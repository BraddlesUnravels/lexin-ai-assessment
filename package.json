{
  "name": "material-register",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "build:api": "tsc -p tsconfig.api.json",
    "build:ui": "vite build --config vite.config.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "start:api": "node dist/api/server.js",
    "format:check": "prettier --check \"*.json\" \"*.js\" \"*.ts\" \"*.yml\" \"src/**/*.{ts,tsx,html}\" \"tests/**/*.{ts,tsx}\" \"docker/**/*.yml\"",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tanstack/react-query": "5.108.0",
    "@trpc/client": "11.29.5",
    "@trpc/server": "11.29.5",
    "@trpc/tanstack-react-query": "11.29.5",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "mantine-datatable": "8.3.13",
    "nuqs": "2.10.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
